{
  "name": "galcode_island",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-tauri.mjs dev",
    "dev:web": "vite",
    "prebuild": "npm run prepare:runtime",
    "build": "node scripts/run-tauri.mjs build",
    "build:web": "vite build",
    "preview": "vite preview",
    "tauri": "node scripts/run-tauri.mjs",
    "typecheck": "tsc -b --noEmit",
    "check:rust": "node scripts/run-cargo.mjs check",
    "fmt:rust": "node scripts/run-cargo.mjs fmt",
    "lint:rust": "node scripts/run-cargo.mjs clippy --all-targets -- -D warnings",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "clean": "node -e \"const fs=require('node:fs');for(const p of ['dist','src-tauri/target','src-tauri/resources/runtime']){fs.rmSync(p,{recursive:true,force:true})}\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2",
    "framer-motion": "^12.38.0",
    "pixi-live2d-display": "^0.5.0-beta",
    "pixi.js": "^7.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.2.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^7.0.4"
  }
}
